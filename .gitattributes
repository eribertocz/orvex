# LF everywhere, also on Windows checkouts.
* text=auto eol=lf

*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.parquet binary
*.duckdb binary
*.sqlite binary
*.xlsx binary
*.woff binary
*.woff2 binary

# Imported and vendored third-party files stay byte-exact (their SHA-256 is verified by tests).
conformance/semantic-corpus/** -text
vendor/** -text
