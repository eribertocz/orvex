{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.invalid/run-record/v1/schema.json",
  "title": "RunRecord",
  "description": "What one model did in one run: which code and versions ran, what it loaded, which snapshot it produced, and how it ended. Models of one run share `run_id`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "model",
    "trigger",
    "materialized",
    "project_commit",
    "project_dirty",
    "versions",
    "since",
    "rows_read",
    "rows_written",
    "watermark",
    "tests",
    "reconciliation",
    "snapshot_id",
    "started_at",
    "finished_at",
    "outcome",
    "error"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "model": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,62}\\.[a-z][a-z0-9_]{0,62}$"
    },
    "trigger": {
      "enum": [
        "manual",
        "schedule",
        "freshness",
        "full_refresh"
      ]
    },
    "materialized": {
      "enum": [
        "view",
        "table",
        "incremental"
      ]
    },
    "project_commit": {
      "description": "Git commit of the project folder, or null when it is not a git repository.",
      "type": [
        "string",
        "null"
      ],
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "project_dirty": {
      "description": "Uncommitted changes in models/, project.yaml or connections.yaml; null when not a git repository.",
      "type": [
        "boolean",
        "null"
      ]
    },
    "versions": {
      "$ref": "#/$defs/Versions"
    },
    "since": {
      "description": "The `$since` value of an incremental run (text, exact); null otherwise.",
      "type": [
        "string",
        "null"
      ]
    },
    "rows_read": {
      "description": "Rows the model's SELECT returned; null when not measured.",
      "oneOf": [
        {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,37})$"
        },
        {
          "type": "null"
        }
      ]
    },
    "rows_written": {
      "description": "Rows written to the target; null when the run did not commit.",
      "oneOf": [
        {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,37})$"
        },
        {
          "type": "null"
        }
      ]
    },
    "watermark": {
      "type": [
        "string",
        "null"
      ]
    },
    "tests": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CheckResult"
      }
    },
    "reconciliation": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CheckResult"
      }
    },
    "snapshot_id": {
      "description": "The snapshot the run committed; null when it did not commit.",
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "started_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "finished_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "outcome": {
      "enum": [
        "success",
        "failed",
        "not_run"
      ]
    },
    "error": {
      "oneOf": [
        {
          "$ref": "#/$defs/RunError"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "Versions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "duckdb",
        "modules"
      ],
      "properties": {
        "duckdb": {
          "type": "string",
          "minLength": 1
        },
        "modules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ModuleVersion"
          }
        }
      }
    },
    "ModuleVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "CheckResult": {
      "description": "One test or reconciliation result (filled from P1-15 and P1-16).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "outcome"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "outcome": {
          "enum": [
            "passed",
            "failed"
          ]
        },
        "failing_rows": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,37})$"
        }
      }
    },
    "RunError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
