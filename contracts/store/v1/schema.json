{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.invalid/store/v1/schema.json",
  "title": "StoreMessage",
  "description": "Messages of the store contract: where the lake is, statements and reads with bound parameters, snapshots, commit results, maintenance reports and errors. Read results are Arrow record-batch streams (see README).",
  "oneOf": [
    {
      "$ref": "#/$defs/LakeLocation"
    },
    {
      "$ref": "#/$defs/StatementRequest"
    },
    {
      "$ref": "#/$defs/ReadRequest"
    },
    {
      "$ref": "#/$defs/Snapshot"
    },
    {
      "$ref": "#/$defs/CommitResult"
    },
    {
      "$ref": "#/$defs/MaintenanceReport"
    },
    {
      "$ref": "#/$defs/StoreError"
    },
    {
      "$ref": "#/$defs/ResultJson"
    },
    {
      "$ref": "#/$defs/SourceAttachment"
    }
  ],
  "$defs": {
    "Parameter": {
      "description": "A named parameter bound to `$name` in the SQL. The value is text converted to the declared DuckDB type; exact values are never JSON numbers.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "value"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "type": {
          "$ref": "#/$defs/ParameterType"
        },
        "value": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "ParameterType": {
      "description": "DuckDB type of a parameter.",
      "type": "string",
      "pattern": "^(BOOLEAN|TINYINT|SMALLINT|INTEGER|BIGINT|HUGEINT|UTINYINT|USMALLINT|UINTEGER|UBIGINT|UHUGEINT|DOUBLE|VARCHAR|DATE|TIMESTAMP|TIMESTAMPTZ|DECIMAL\\(([1-9]|[12][0-9]|3[0-8]),([0-9]|[12][0-9]|3[0-8])\\))$"
    },
    "StatementRequest": {
      "description": "One SQL statement executed in a write transaction.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "sql",
        "parameters"
      ],
      "properties": {
        "kind": {
          "const": "statement"
        },
        "sql": {
          "type": "string",
          "minLength": 1
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Parameter"
          }
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600000,
          "description": "Time limit in milliseconds, waiting for a slot included (default: the lake's default_timeout_ms)."
        }
      }
    },
    "ReadRequest": {
      "description": "One SELECT statement read once, as of a snapshot, as an Arrow record-batch stream.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "sql",
        "parameters",
        "snapshot",
        "batch_size"
      ],
      "properties": {
        "kind": {
          "const": "read"
        },
        "sql": {
          "type": "string",
          "minLength": 1
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Parameter"
          }
        },
        "snapshot": {
          "type": "integer",
          "minimum": 0
        },
        "batch_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600000,
          "description": "Time limit in milliseconds, waiting for a slot included (default: the lake's default_timeout_ms)."
        }
      }
    },
    "Snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "committed_at"
      ],
      "properties": {
        "kind": {
          "const": "snapshot"
        },
        "id": {
          "type": "integer",
          "minimum": 0
        },
        "committed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "CommitResult": {
      "description": "The snapshot a committed transaction created, or null when it changed nothing.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "snapshot"
      ],
      "properties": {
        "kind": {
          "const": "commit_result"
        },
        "snapshot": {
          "oneOf": [
            {
              "$ref": "#/$defs/Snapshot"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "MaintenanceReport": {
      "description": "What one maintenance call did: snapshots older than its cutoff expired, small files merged, files with many deletes rewritten, files no snapshot uses deleted, and orphaned files deleted. `oldest_snapshot` is the oldest snapshot kept; reads pinned to an older one fail with `STORE_SNAPSHOT_EXPIRED`.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "snapshots_expired",
        "files_merged",
        "files_created",
        "files_rewritten",
        "files_deleted",
        "orphaned_files_deleted",
        "oldest_snapshot"
      ],
      "properties": {
        "kind": {
          "const": "maintenance_report"
        },
        "snapshots_expired": {
          "type": "integer",
          "minimum": 0
        },
        "files_merged": {
          "type": "integer",
          "minimum": 0
        },
        "files_created": {
          "type": "integer",
          "minimum": 0
        },
        "files_rewritten": {
          "type": "integer",
          "minimum": 0
        },
        "files_deleted": {
          "type": "integer",
          "minimum": 0
        },
        "orphaned_files_deleted": {
          "type": "integer",
          "minimum": 0
        },
        "oldest_snapshot": {
          "$ref": "#/$defs/Snapshot"
        }
      }
    },
    "ErrorCode": {
      "type": "string",
      "enum": [
        "STORE_SNAPSHOT_NOT_FOUND",
        "STORE_SNAPSHOT_EXPIRED",
        "STORE_STATEMENT_INVALID",
        "STORE_QUERY_FAILED",
        "STORE_PARAMETER_INVALID",
        "STORE_LIMITS_REQUIRED",
        "STORE_EXTENSION_UNAVAILABLE",
        "STORE_TRANSACTION_CONFLICT",
        "STORE_SECRET_MISSING",
        "STORE_SECRET_INLINE",
        "STORE_CATALOG_UNAVAILABLE",
        "STORE_LOCATION_INVALID",
        "STORE_TLS_REQUIRED",
        "STORE_TYPE_UNSUPPORTED",
        "STORE_TIMEOUT",
        "STORE_CANCELLED",
        "STORE_BUSY",
        "SOURCE_NOT_FOUND",
        "STORE_SOURCE_INVALID",
        "STORE_CONNECTION_FAILED",
        "UNSUPPORTED_SOURCE_TYPE"
      ]
    },
    "ErrorDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string"
        }
      }
    },
    "StoreError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "code",
        "message",
        "details"
      ],
      "properties": {
        "kind": {
          "const": "store_error"
        },
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "details": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ErrorDetail"
          }
        }
      }
    },
    "LocalLakeLocation": {
      "description": "A DuckLake lake with a DuckDB-file catalog (one process): the catalog at <catalog_path>, by default <path>/catalog.ducklake, and data files under <data_path>, by default <path>/data/.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "catalog",
        "path"
      ],
      "properties": {
        "kind": {
          "const": "lake_location"
        },
        "catalog": {
          "const": "local"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "catalog_path": {
          "type": "string",
          "minLength": 1,
          "description": "Absolute path of the catalog file, when it is not <path>/catalog.ducklake. The file sandbox gains exactly that file and its write-ahead log."
        },
        "data_path": {
          "type": "string",
          "minLength": 1,
          "description": "Where data files are written, when not <path>/data/: an absolute local folder, or s3://bucket/prefix/ with storage."
        },
        "storage": {
          "$ref": "#/$defs/S3Storage"
        },
        "encrypted": {
          "type": "boolean",
          "description": "DuckLake data-file encryption (ENCRYPTED), used when the lake is created."
        }
      }
    },
    "SqliteLakeLocation": {
      "description": "A DuckLake lake with a SQLite-file catalog (several processes on one machine): the catalog at <path>, data files under <data_path>. The file sandbox gains exactly the catalog file and its -wal, -shm and -journal files.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "catalog",
        "path",
        "data_path"
      ],
      "properties": {
        "kind": {
          "const": "lake_location"
        },
        "catalog": {
          "const": "sqlite"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "data_path": {
          "type": "string",
          "minLength": 1
        },
        "storage": {
          "$ref": "#/$defs/S3Storage"
        },
        "encrypted": {
          "type": "boolean",
          "description": "DuckLake data-file encryption (ENCRYPTED), used when the lake is created."
        }
      }
    },
    "PostgresLakeLocation": {
      "description": "A DuckLake lake whose catalog lives in PostgreSQL, so several processes can read and write it. The password is never part of the location: it is read from the environment variable named by password_env. A host other than the local machine (localhost, 127.0.0.1, ::1, a Unix-socket directory) needs sslmode=verify-full (STORE_TLS_REQUIRED otherwise).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "catalog",
        "connection",
        "password_env",
        "data_path"
      ],
      "properties": {
        "kind": {
          "const": "lake_location"
        },
        "catalog": {
          "const": "postgres"
        },
        "connection": {
          "type": "string",
          "minLength": 1,
          "description": "libpq key=value connection string without a password, e.g. host=db port=5432 dbname=lake user=analytics sslmode=verify-full"
        },
        "password_env": {
          "type": "string",
          "pattern": "^[A-Z_][A-Z0-9_]*$"
        },
        "metadata_schema": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_]*$",
          "description": "PostgreSQL schema holding the catalog tables (default: public)"
        },
        "data_path": {
          "type": "string",
          "minLength": 1
        },
        "storage": {
          "$ref": "#/$defs/S3Storage"
        },
        "encrypted": {
          "type": "boolean",
          "description": "DuckLake data-file encryption (ENCRYPTED), used when the lake is created."
        }
      }
    },
    "LakeLocation": {
      "description": "Where the lake is.",
      "oneOf": [
        {
          "$ref": "#/$defs/LocalLakeLocation"
        },
        {
          "$ref": "#/$defs/SqliteLakeLocation"
        },
        {
          "$ref": "#/$defs/PostgresLakeLocation"
        }
      ]
    },
    "ResultColumn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "description": "DuckDB type name, e.g. DECIMAL(18,4) or TIMESTAMP WITH TIME ZONE"
        }
      }
    },
    "ResultJson": {
      "description": "A read result encoded as JSON without losing exactness (README: encoding rules). Rows are positional arrays matching columns.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "columns",
        "rows"
      ],
      "properties": {
        "kind": {
          "const": "result_json"
        },
        "columns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ResultColumn"
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": [
                "string",
                "number",
                "boolean",
                "null"
              ]
            }
          }
        }
      }
    },
    "FileSourceAttachment": {
      "description": "A file source (Parquet, CSV, DuckDB) the lake reads inside write transactions, by name: `<name>.data` for parquet and csv (every matching file as one table, columns united by name), `<name>.<schema>.<table>` (or `<name>.<table>` for `main`) for a DuckDB file attached read-only. Reads never see sources. Only the declared paths become readable.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "name",
        "type",
        "path"
      ],
      "properties": {
        "kind": {
          "const": "source_attachment"
        },
        "name": {
          "description": "The connection name; becomes a catalog name in SQL.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,62}$",
          "not": {
            "enum": [
              "lake",
              "main",
              "memory",
              "system",
              "temp"
            ]
          }
        },
        "type": {
          "enum": [
            "parquet",
            "csv",
            "duckdb"
          ]
        },
        "path": {
          "description": "Absolute path; parquet and csv may use a glob (`*`, `?`, `[...]`, `**`) in their file name or folders.",
          "type": "string",
          "minLength": 2,
          "maxLength": 4096,
          "pattern": "^(/|[A-Za-z]:[\\\\/])"
        }
      }
    },
    "SqliteSourceAttachment": {
      "description": "A SQLite database file attached read-only: `<name>.<table>`. Columns declared DECIMAL or NUMERIC (stored by SQLite as floating point) are refused when a write reads them (`UNSUPPORTED_SOURCE_TYPE`).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "name",
        "type",
        "path"
      ],
      "properties": {
        "kind": {
          "const": "source_attachment"
        },
        "name": {
          "description": "The connection name; becomes a catalog name in SQL.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,62}$",
          "not": {
            "enum": [
              "lake",
              "main",
              "memory",
              "system",
              "temp"
            ]
          }
        },
        "type": {
          "const": "sqlite"
        },
        "path": {
          "description": "Absolute path; parquet and csv may use a glob (`*`, `?`, `[...]`, `**`) in their file name or folders.",
          "type": "string",
          "minLength": 2,
          "maxLength": 4096,
          "pattern": "^(/|[A-Za-z]:[\\\\/])"
        }
      }
    },
    "PostgresSourceAttachment": {
      "description": "A PostgreSQL database attached read-only (also `default_transaction_read_only` on its session): `<name>.<table>` when `schema` is given, otherwise `<name>.<schema>.<table>`. The password is read from the environment variable `password_env` and never appears in errors. Columns `numeric` without precision and `money` are refused when a write reads them (`UNSUPPORTED_SOURCE_TYPE`). A host other than the local machine (localhost, 127.0.0.1, ::1) needs sslmode verify-full (STORE_TLS_REQUIRED otherwise).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "name",
        "type",
        "host",
        "port",
        "database",
        "user",
        "password_env"
      ],
      "properties": {
        "kind": {
          "const": "source_attachment"
        },
        "name": {
          "description": "The connection name; becomes a catalog name in SQL.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,62}$",
          "not": {
            "enum": [
              "lake",
              "main",
              "memory",
              "system",
              "temp"
            ]
          }
        },
        "type": {
          "const": "postgres"
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "database": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^'\\\\\\s]+$"
        },
        "user": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^'\\\\\\s]+$"
        },
        "password_env": {
          "type": "string",
          "pattern": "^[A-Z_][A-Z0-9_]*$"
        },
        "schema": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$"
        },
        "sslmode": {
          "description": "libpq sslmode: verify-full, or disable for the local machine only; absent, libpq's default (local machine only).",
          "enum": [
            "verify-full",
            "disable"
          ]
        },
        "sslrootcert": {
          "description": "With verify-full: `system` (the default) or `${env:NAME}`, a variable holding the path of a CA file, read by the store when the lake opens.",
          "type": "string",
          "pattern": "^(system|\\$\\{env:[A-Z_][A-Z0-9_]*\\})$"
        }
      }
    },
    "SourceAttachment": {
      "description": "A source the lake reads inside write transactions, by name; reads never see sources.",
      "oneOf": [
        {
          "$ref": "#/$defs/FileSourceAttachment"
        },
        {
          "$ref": "#/$defs/SqliteSourceAttachment"
        },
        {
          "$ref": "#/$defs/PostgresSourceAttachment"
        }
      ]
    },
    "S3Storage": {
      "description": "Object storage for data files, reached through DuckDB's official httpfs extension with a temporary secret scoped to data_path. The credentials are read from the environment variables named here. use_ssl false is refused unless the endpoint is the local machine (STORE_TLS_REQUIRED).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "region",
        "key_id_env",
        "secret_env",
        "use_ssl"
      ],
      "properties": {
        "type": {
          "const": "s3"
        },
        "region": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9-]+$"
        },
        "endpoint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 260,
          "pattern": "^[A-Za-z0-9.\\-]+(:[0-9]{1,5})?$|^\\[[0-9A-Fa-f:]+\\](:[0-9]{1,5})?$"
        },
        "url_style": {
          "enum": [
            "path",
            "vhost"
          ]
        },
        "use_ssl": {
          "type": "boolean"
        },
        "key_id_env": {
          "type": "string",
          "pattern": "^[A-Z_][A-Z0-9_]*$"
        },
        "secret_env": {
          "type": "string",
          "pattern": "^[A-Z_][A-Z0-9_]*$"
        }
      }
    }
  }
}
