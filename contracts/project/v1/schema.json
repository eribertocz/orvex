{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.invalid/project/v1/schema.json",
  "title": "ProjectDocument",
  "description": "The files of a project folder that the Builder edits by hand: `project.yaml` and `connections.yaml` (parsed from YAML), and the errors of loading them.",
  "oneOf": [
    {
      "$ref": "#/$defs/ProjectFile"
    },
    {
      "$ref": "#/$defs/ConnectionsFile"
    },
    {
      "$ref": "#/$defs/ProjectError"
    }
  ],
  "$defs": {
    "ProjectFile": {
      "description": "`project.yaml`.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "name",
        "time_zone"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$",
          "description": "Display name of the project; no control characters."
        },
        "time_zone": {
          "description": "IANA time zone name (for example `America/La_Paz`); required, never implicit. The loader checks it against the IANA database.",
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_+-]*(/[A-Za-z0-9_+-]+)*$",
          "maxLength": 64
        },
        "locale": {
          "enum": [
            "es",
            "en"
          ],
          "default": "es"
        },
        "retention": {
          "$ref": "#/$defs/Retention"
        },
        "lineage": {
          "$ref": "#/$defs/Lineage"
        },
        "lake": {
          "$ref": "#/$defs/Lake"
        }
      }
    },
    "Retention": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "snapshots": {
          "description": "How long lake snapshots are kept: `<n>d`, at least `1d`.",
          "type": "string",
          "pattern": "^[1-9][0-9]{0,4}d$",
          "default": "90d"
        }
      }
    },
    "ConnectionsFile": {
      "description": "`connections.yaml`: data sources by name. A name becomes a SQL schema, so it follows identifier rules and cannot be `lake`.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "connections"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "connections": {
          "description": "Connections by name. A name becomes a SQL schema: lowercase identifier, not `lake`.",
          "type": "object",
          "propertyNames": {
            "type": "string",
            "not": {
              "const": "lake"
            }
          },
          "patternProperties": {
            "^[a-z][a-z0-9_]{0,62}$": {
              "$ref": "#/$defs/Connection"
            }
          },
          "additionalProperties": false
        }
      }
    },
    "Connection": {
      "oneOf": [
        {
          "$ref": "#/$defs/ParquetConnection"
        },
        {
          "$ref": "#/$defs/CsvConnection"
        },
        {
          "$ref": "#/$defs/DuckdbConnection"
        },
        {
          "$ref": "#/$defs/SqliteConnection"
        },
        {
          "$ref": "#/$defs/PostgresConnection"
        },
        {
          "$ref": "#/$defs/ClickhouseConnection"
        }
      ]
    },
    "Path": {
      "description": "A file path; relative paths are resolved against the project folder. Globs are allowed for `parquet` and `csv`.",
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "ReadOnly": {
      "description": "Required for database connections. `false` is valid here and refused by the loader with `SOURCE_NOT_READ_ONLY`: every database source is read-only in v1.",
      "type": "boolean"
    },
    "SecretReference": {
      "description": "A reference to an environment variable: `${env:NAME}`. The value is read when the connection is used and never stored.",
      "type": "string",
      "pattern": "^\\$\\{env:[A-Z_][A-Z0-9_]*\\}$"
    },
    "ParquetConnection": {
      "description": "Parquet files (a path or a glob).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "path"
      ],
      "properties": {
        "type": {
          "const": "parquet"
        },
        "path": {
          "$ref": "#/$defs/Path"
        }
      }
    },
    "CsvConnection": {
      "description": "CSV files (a path or a glob).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "path"
      ],
      "properties": {
        "type": {
          "const": "csv"
        },
        "path": {
          "$ref": "#/$defs/Path"
        }
      }
    },
    "DuckdbConnection": {
      "description": "A DuckDB database file.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "path",
        "read_only"
      ],
      "properties": {
        "type": {
          "const": "duckdb"
        },
        "path": {
          "$ref": "#/$defs/Path"
        },
        "read_only": {
          "$ref": "#/$defs/ReadOnly"
        }
      }
    },
    "SqliteConnection": {
      "description": "A SQLite database file.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "path",
        "read_only"
      ],
      "properties": {
        "type": {
          "const": "sqlite"
        },
        "path": {
          "$ref": "#/$defs/Path"
        },
        "read_only": {
          "$ref": "#/$defs/ReadOnly"
        }
      }
    },
    "PostgresConnection": {
      "description": "A PostgreSQL database. `schema`, when given, limits the connection to that schema. A host other than the local machine (`localhost`, `127.0.0.1`, `::1`, a Unix-socket directory) needs `ssl_mode: verify-full`; the loader refuses it otherwise with `SOURCE_TLS_REQUIRED`.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "host",
        "port",
        "database",
        "user",
        "password",
        "read_only"
      ],
      "properties": {
        "type": {
          "const": "postgres"
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "database": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "user": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "password": {
          "$ref": "#/$defs/SecretReference"
        },
        "read_only": {
          "$ref": "#/$defs/ReadOnly"
        },
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "ssl_mode": {
          "description": "libpq `sslmode`: `verify-full` (TLS that checks the server's certificate and name), or `disable` for the local machine only. Absent: libpq's default, accepted on the local machine only.",
          "enum": [
            "verify-full",
            "disable"
          ]
        },
        "ssl_root_cert": {
          "description": "Certificate authorities that verify the server with `verify-full`: `system` (the operating system's store, the default) or `${env:NAME}`, a variable holding the path of a CA file.",
          "type": "string",
          "pattern": "^(system|\\$\\{env:[A-Z_][A-Z0-9_]*\\})$",
          "default": "system"
        }
      }
    },
    "ClickhouseConnection": {
      "description": "A ClickHouse database.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "host",
        "port",
        "database",
        "user",
        "password",
        "read_only"
      ],
      "properties": {
        "type": {
          "const": "clickhouse"
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "database": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "user": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "password": {
          "$ref": "#/$defs/SecretReference"
        },
        "secure": {
          "description": "TLS to the server; default true.",
          "type": "boolean",
          "default": true
        },
        "read_only": {
          "$ref": "#/$defs/ReadOnly"
        }
      }
    },
    "ProjectErrorCode": {
      "enum": [
        "PROJECT_NOT_FOUND",
        "PROJECT_YAML_INVALID",
        "PROJECT_SCHEMA_INVALID",
        "PROJECT_VERSION_UNSUPPORTED",
        "PROJECT_SECRET_MISSING",
        "SOURCE_NOT_READ_ONLY",
        "SOURCE_TLS_REQUIRED",
        "LAKE_LOCATION_INVALID",
        "LAKE_TLS_REQUIRED",
        "LAKE_LOCATION_CHANGED"
      ]
    },
    "ProjectError": {
      "description": "A project that cannot be loaded or a secret that cannot be resolved. `details` names the file, the location of the problem as a JSON pointer (`path`) and its `line` when known; never a secret value.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "details"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/ProjectErrorCode"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "details": {
          "$ref": "#/$defs/ProjectErrorDetails"
        }
      }
    },
    "ProjectErrorDetails": {
      "description": "Where the problem is. `path` is a JSON pointer into the file (`/connections/production/password`); `variable` names an environment variable, never its value.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "connection": {
          "type": "string",
          "minLength": 1
        },
        "variable": {
          "type": "string",
          "pattern": "^[A-Z_][A-Z0-9_]*$"
        }
      }
    },
    "Lineage": {
      "description": "Where OpenLineage events are also sent (P1-18); they are always written under the project's local folder.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "description": "An OpenLineage HTTP endpoint: `https://`, or `http://` only on this machine (`localhost`, `127.0.0.1`); no user or password in the URL (use `api_key`). Events are POSTed to it after each run.",
          "type": "string",
          "pattern": "^(https://[^\\s/@]+(/[^\\s]*)?|http://(localhost|127\\.0\\.0\\.1)(:[0-9]{1,5})?(/[^\\s]*)?)$",
          "maxLength": 2048
        },
        "api_key": {
          "$ref": "#/$defs/SecretReference"
        }
      }
    },
    "Lake": {
      "description": "Where the project's managed lake lives (ADR-0027 §2). Absent: a DuckDB-file catalog and data files in the project's own folder, as before. A lake's catalog, data location and encryption are fixed when the lake is created.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "catalog": {
          "$ref": "#/$defs/LakeCatalog"
        },
        "data": {
          "$ref": "#/$defs/LakeData"
        },
        "encrypted": {
          "description": "DuckLake data-file encryption, fixed when the lake is created. The keys are stored in the catalog: encryption protects the files only from someone without catalog access.",
          "type": "boolean",
          "default": false
        }
      }
    },
    "LakeCatalog": {
      "description": "The lake's catalog database.",
      "oneOf": [
        {
          "$ref": "#/$defs/DuckdbLakeCatalog"
        },
        {
          "$ref": "#/$defs/SqliteLakeCatalog"
        },
        {
          "$ref": "#/$defs/PostgresLakeCatalog"
        }
      ]
    },
    "CatalogPath": {
      "description": "A catalog file on a local disk; a relative path is resolved against the project folder. The loader refuses object-storage URLs and network or remote file systems.",
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "DuckdbLakeCatalog": {
      "description": "A DuckDB-file catalog (one process). Default path: `.<slug>/lake/catalog.ducklake`.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "duckdb"
        },
        "path": {
          "$ref": "#/$defs/CatalogPath"
        }
      }
    },
    "SqliteLakeCatalog": {
      "description": "A SQLite-file catalog (several processes on one machine). Default path: `.<slug>/lake/catalog.sqlite`.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "sqlite"
        },
        "path": {
          "$ref": "#/$defs/CatalogPath"
        }
      }
    },
    "PostgresLakeCatalog": {
      "description": "A PostgreSQL catalog: on the same machine, on the network or a managed cloud service. Any host other than the local machine (`localhost`, `127.0.0.1`, `::1`, a Unix-socket directory) needs `ssl_mode: verify-full`; the loader refuses other modes with `LAKE_TLS_REQUIRED`.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "host",
        "database",
        "user",
        "password"
      ],
      "properties": {
        "type": {
          "const": "postgres"
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "default": 5432
        },
        "database": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "user": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "password": {
          "$ref": "#/$defs/SecretReference"
        },
        "schema": {
          "description": "PostgreSQL schema holding the catalog tables (DuckLake `METADATA_SCHEMA`); default `public`.",
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_]*$",
          "maxLength": 63
        },
        "ssl_mode": {
          "description": "libpq `sslmode`. Required to be `verify-full` for any host other than the local machine.",
          "enum": [
            "disable",
            "allow",
            "prefer",
            "require",
            "verify-ca",
            "verify-full"
          ]
        },
        "ssl_root_cert": {
          "description": "Certificate authorities that verify the server: `system` (the operating system's store, the default) or `${env:NAME}`, a variable holding the path of a CA file.",
          "type": "string",
          "pattern": "^(system|\\$\\{env:[A-Z_][A-Z0-9_]*\\})$",
          "default": "system"
        }
      }
    },
    "LakeData": {
      "description": "Where the lake's data files live: a local folder (relative to the project folder; a network file system mounted at the same path counts) or S3-compatible object storage (`s3://bucket/prefix/`, with `s3`). Default: `.<slug>/lake/data/`.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "s3": {
          "$ref": "#/$defs/S3Storage"
        }
      }
    },
    "S3Storage": {
      "description": "S3 or an S3-compatible service. Credentials only as `${env:NAME}`; they become a temporary DuckDB secret. `use_ssl: false` is accepted only for an endpoint on the local machine.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "region",
        "key_id",
        "secret"
      ],
      "properties": {
        "region": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9-]+$"
        },
        "endpoint": {
          "description": "Host and optional port of an S3-compatible service (no scheme); default AWS S3.",
          "type": "string",
          "minLength": 1,
          "maxLength": 260,
          "pattern": "^[A-Za-z0-9.\\-]+(:[0-9]{1,5})?$|^\\[[0-9A-Fa-f:]+\\](:[0-9]{1,5})?$"
        },
        "url_style": {
          "enum": [
            "path",
            "vhost"
          ]
        },
        "use_ssl": {
          "type": "boolean",
          "default": true
        },
        "key_id": {
          "$ref": "#/$defs/SecretReference"
        },
        "secret": {
          "$ref": "#/$defs/SecretReference"
        }
      }
    }
  }
}
