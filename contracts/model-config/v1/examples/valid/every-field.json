{"version": 1, "description": "Meter readings, one row per reading", "owner": "eriberto", "materialized": "incremental", "incremental": {"strategy": "merge", "unique_key": ["reading_id"], "time_column": "updated_at", "lookback": "1h", "partition_by": ["reading_month"], "filter": "auto"}, "freshness": "10m", "full_refresh": {"cron": "0 3 * * 0", "time_zone": "America/La_Paz"}, "on_schema_change": "fail", "tests": [{"unique": ["reading_id"]}, {"not_null": ["reading_id", "consumer_id", "read_at"]}, {"accepted_range": {"column": "kwh", "min": 0}}, {"accepted_values": {"column": "status", "values": ["valid", "estimated", "voided"]}}, {"relationship": {"column": "consumer_id", "to": "staging.consumers", "field": "consumer_id"}}], "reconciliation": [{"name": "kwh_by_month", "measure": "sum(kwh)", "group_by": ["date_trunc('month', read_at)"], "source": "production.readings", "tolerance": 0}]}
